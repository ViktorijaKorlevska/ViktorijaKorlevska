---
export interface Props {
  profile?: any
}

const { profile } = Astro.props
---

<footer class="site-foot">
  <div class="site-foot__logo">
    <a href={`mailto:${profile?.email}`}>
      <svg
        width="280"
        height="280"
        viewBox="0 0 280 280"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M0 0v280h120v-280h-40v240H40V0H0Z" fill="currentColor"></path>
        <path
          d="M160 0v280h40v-120h40v120h40V150h-40v-20h40V0h-40v120h-40V0h-40Z"
          fill="currentColor"
        >
        </path>
      </svg>

      <span class="u-sr-only">{profile?.name || 'Viktorija Korlevska'}</span>
    </a>
  </div><!-- .site-foot__logo -->
</footer>

<style lang="scss">
  .site-foot {
    @include flex(row, center, center);

    position: relative;
    z-index: 3;

    padding: 1.5rem;

    border-top: 1px solid color(secondary);

    @include mq(phone) {
      padding: 1rem;
    }

    &__logo {
      svg {
        display: block;
        width: 3rem;
        height: 3rem;

        color: #000;

        @include mq(phone) {
          width: 1.875rem;
          height: 1.875rem;
        }
      }

      a {
        color: inherit;
        text-decoration: none;

        &:hover,
        &:visited,
        &:active {
          color: #000;
        }
      }
    }
  }
</style>
